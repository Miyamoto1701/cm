<Window x:Class="ChatClient.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с именем комнаты -->
        <TextBlock x:Name="TxtHeader" Grid.Row="0"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"
                   Foreground="#2196F3"/>

        <!-- Список сообщений -->
        <ListBox x:Name="LstMessages" Grid.Row="1"
                 FontSize="13" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,8"/>

        <!-- Панель отправки -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtMessage" Grid.Column="0"
                     Height="36" FontSize="13" Margin="0,0,8,0"
                     KeyDown="TxtMessage_KeyDown"/>
            <Button Content="Отправить" Grid.Column="1" Height="36"
                    FontSize="12" Background="#2196F3" Foreground="White"
                    Click="BtnSend_Click"/>
        </Grid>
    </Grid>
</Window>
