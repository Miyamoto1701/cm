<Window x:Class="ChatClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в чат" Height="220" Width="360"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Имя пользователя:" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtUserName" Height="32" FontSize="14" Margin="0,0,0,12"/>

        <TextBlock Text="Название комнаты:" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtRoomName" Height="32" FontSize="14" Margin="0,0,0,20"/>

        <Button Content="Войти" Height="36" FontSize="14"
                Click="BtnLogin_Click" Background="#2196F3" Foreground="White"/>
    </StackPanel>
</Window>
